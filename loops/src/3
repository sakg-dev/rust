fn loop1() {
    // Infinite loop incoming
    let mut idx = 0;
    loop {
        idx += 1;
        println!("Hey I will run again!");
        println!("{idx}");

        if idx >= 100{
            break;
        }

        if idx % 2 == 0 {
            continue;
        }

        println!("some operation on odd number");

        println!("-------------------")
    }
}

fn loop2() {
    let mut count = 0;
    let my_loop = loop {
        count += 1;
        if count == 10 {
            break count * 2;
        }
    }; // need ; not for loop but for the variable assignment
    println!("{my_loop}");
}

fn disambiguos_loop() {
    let mut count = 0;
    println!("Initializing loop");
    let my_loop = 'father: loop{
        if count >= 10 {
            break 'father;
            println!("Loop ends")
        }

        let mut remaining = 10;
        loop {
            if remaining == 8 {
                break;
            }
            remaining -= 1;
        }

        count += 1;
    };
}
